{
  "name": "android-controls",
  "publisher": "vstab",
  "displayName": "vstab Remote SSH",
  "description": "Built-in Android workspace and Remote SSH actions for vstab.",
  "version": "0.2.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "browser": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "vstab.ssh.connect",
        "title": "Connect to Host...",
        "category": "Remote-SSH",
        "icon": "$(remote)"
      },
      {
        "command": "vstab.ssh.addHost",
        "title": "Add New SSH Host...",
        "category": "Remote-SSH",
        "icon": "$(add)"
      },
      {
        "command": "vstab.ssh.openConfig",
        "title": "Open SSH Configuration File...",
        "category": "Remote-SSH",
        "icon": "$(gear)"
      },
      {
        "command": "vstab.ssh.editHost",
        "title": "Edit SSH Configuration",
        "category": "Remote-SSH",
        "icon": "$(edit)"
      },
      {
        "command": "vstab.ssh.removeHost",
        "title": "Remove SSH Host",
        "category": "Remote-SSH",
        "icon": "$(trash)"
      },
      {
        "command": "vstab.ssh.importKey",
        "title": "Import SSH Private Key...",
        "category": "Remote-SSH",
        "icon": "$(key)"
      },
      {
        "command": "vstab.ssh.refresh",
        "title": "Refresh",
        "category": "Remote-SSH",
        "icon": "$(refresh)"
      },
      {
        "command": "vstab.ssh.showHosts",
        "title": "Show SSH Hosts",
        "category": "Remote-SSH",
        "icon": "$(list-tree)"
      },
      {
        "command": "vstab.ssh.browse",
        "title": "Open Folder on Host...",
        "category": "Remote-SSH",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vstab.ssh.openFolder",
        "title": "Open Folder",
        "category": "Remote-SSH",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vstab.ssh.reconnect",
        "title": "Reconnect to Host",
        "category": "Remote-SSH",
        "icon": "$(debug-restart)"
      },
      {
        "command": "vstab.ssh.disconnect",
        "title": "Close Remote Connection",
        "category": "Remote-SSH",
        "icon": "$(close-remote)"
      },
      {
        "command": "vstab.workspace.local",
        "title": "Open Android Workspace",
        "category": "vstab",
        "icon": "$(device-mobile)"
      },
      {
        "command": "vstab.about",
        "title": "About vstab",
        "category": "Help",
        "icon": "$(info)"
      },
      {
        "command": "vstab.window.new",
        "title": "New Workspace Window...",
        "category": "vstab"
      },
      {
        "command": "vstab.documents.openFolder",
        "title": "Open Shared Folder...",
        "category": "vstab"
      },
      {
        "command": "vstab.documents.openFile",
        "title": "Open Android File...",
        "category": "vstab"
      },
      {
        "command": "vstab.documents.sync",
        "title": "Sync Shared Files Now",
        "category": "vstab"
      },
      {
        "command": "vstab.documents.review",
        "title": "Review Shared-file Conflicts...",
        "category": "vstab"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vstab-remote-explorer",
          "title": "Remote Explorer",
          "icon": "remote.svg"
        }
      ]
    },
    "views": {
      "vstab-remote-explorer": [
        {
          "id": "vstab.sshTargets",
          "name": "SSH Targets",
          "icon": "remote.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vstab.sshTargets",
        "contents": "Connect to an SSH host to browse its folders and open a project.\n[Add New SSH Host...](command:vstab.ssh.addHost)\n[Open SSH Configuration File...](command:vstab.ssh.openConfig)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vstab.ssh.addHost",
          "when": "view == vstab.sshTargets",
          "group": "navigation@1"
        },
        {
          "command": "vstab.ssh.openConfig",
          "when": "view == vstab.sshTargets",
          "group": "navigation@2"
        },
        {
          "command": "vstab.ssh.refresh",
          "when": "view == vstab.sshTargets",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "vstab.ssh.connect",
          "when": "view == vstab.sshTargets && viewItem == sshHost",
          "group": "inline@1"
        },
        {
          "command": "vstab.ssh.browse",
          "when": "view == vstab.sshTargets && viewItem == sshHostConnected",
          "group": "inline@1"
        },
        {
          "command": "vstab.ssh.reconnect",
          "when": "view == vstab.sshTargets && viewItem == sshHostError",
          "group": "inline@1"
        },
        {
          "command": "vstab.ssh.openFolder",
          "when": "view == vstab.sshTargets && viewItem == sshFolder",
          "group": "inline@1"
        },
        {
          "command": "vstab.ssh.editHost",
          "when": "view == vstab.sshTargets && (viewItem == sshHost || viewItem == sshHostConnected || viewItem == sshHostError)",
          "group": "ssh@1"
        },
        {
          "command": "vstab.ssh.importKey",
          "when": "view == vstab.sshTargets && (viewItem == sshHost || viewItem == sshHostConnected || viewItem == sshHostError)",
          "group": "ssh@2"
        },
        {
          "command": "vstab.ssh.removeHost",
          "when": "view == vstab.sshTargets && (viewItem == sshHost || viewItem == sshHostConnected || viewItem == sshHostError)",
          "group": "ssh@3"
        }
      ]
    },
    "languages": [
      {
        "id": "ssh_config",
        "aliases": [
          "SSH Configuration",
          "ssh_config"
        ],
        "filenames": [
          "ssh_config"
        ],
        "filenamePatterns": [
          "**/.ssh/config"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ssh_config",
        "scopeName": "source.ssh-config",
        "path": "./syntaxes/ssh-config.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ssh_config",
        "path": "./snippets/ssh-config.json"
      }
    ],
    "configuration": {
      "title": "vstab Remote SSH",
      "properties": {
        "vstab.ssh.showHiddenFolders": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Show folders beginning with a dot when browsing an SSH host."
        }
      }
    }
  },
  "enabledApiProposals": [
    "ipc"
  ]
}
